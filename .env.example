# Local PostgreSQL configuration (copy to .env for Docker Compose)
POSTGRES_DB=smart_certificate
POSTGRES_USER=smart_cert_user
POSTGRES_PASSWORD=smart_cert_local_pass
POSTGRES_PORT=5432

# Backend Spring Boot configuration
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/smart_certificate
DB_USERNAME=smart_cert_user
DB_PASSWORD=smart_cert_local_pass
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-random-64-char-secret-in-production
STORAGE_SIGNED_URL_SECRET=replace-with-a-random-64-char-secret-in-production
AUTH_COOKIE_SECURE=false
SELF_REGISTRATION_ENABLED=true

# Frontend Next.js configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
